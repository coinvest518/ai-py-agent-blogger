# FDWA AI Agent Environment Variables
# Copy this file to .env and fill in your values
# For GitHub Actions: Add these as repository secrets in Settings → Secrets → Actions
# Or create a GitHub Environment called "production" with these secrets
#
# Sync policy: every var below that has a secret value MUST also exist as a
# GitHub Secret. Non-secret toggles (BLOG_*, LINKEDIN_DAILY_LIMIT, RENDER_ROLE,
# SUPERVISOR_ENABLED, UPLOAD_POST_WEEKLY_CAP, COMPOSIO_TOOLKIT_VERSION_*) are
# hardcoded in .github/workflows/scheduler.yml — not in Secrets.
# See docs/GITHUB_SECRETS_SYNC.md for the exact rename/add/remove checklist.

# ===========================================
# LLM API Keys
# ===========================================
MISTRAL_API_KEY=your_mistral_key
OPENROUTER_API_KEY=your_openrouter_key
APIFREELLM_API_KEY=your_apifreellm_key
GOOGLE_AI_API_KEY=your_google_ai_key

# HuggingFace (for image generation fallback)
HF_TOKEN=hf_your_token_here
HF_ENABLE=false  # Set to true to enable HuggingFace image fallback (requires credits)

# ===========================================
# LANGSMITH (Required for tracing)
# ===========================================
LANGSMITH_API_KEY=lsv2_your_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=fdwa-multi-agent
LANGSMITH_WORKSPACE_ID=your_workspace_id

# ===========================================
# COMPOSIO (Social media integrations)
# Get at: https://composio.dev
# ===========================================
COMPOSIO_API_KEY=your_composio_key



# ===========================================
# FACEBOOK
# ===========================================
FACEBOOK_PAGE_ACCESS_TOKEN=EAARcXUmQTf8BRIMELrwSPFohhzRPgEyZBLcLcXSjmwvr43oZAcStkoGPByWi1NFfNHcXLyWr4HZAdzjl3O2m0ZB7n1ZBqS0xJLKq48rA1SF7ctZC0I0jxZCUqXJyn2jriE8zrikX0BID8EDXBS1ma24fZC04ZBYYXMNpxGsW0pANwqkcHPBLiJ7aZAIpAjrL05gUGVgBm1P6oPtZCQqjPYIAMOZCJCWFs9NDQfYoqQZDZD
FACEBOOK_PAGE_ID=745368186361835

# ===========================================
# LINKEDIN
# ===========================================
LINKEDIN_ACCOUNT_ID=your_account_id
LINKEDIN_USER_ID=your_user_id
LINKEDIN_AUTHOR_URN=urn:li:person:your_id
LINKEDIN_ACCESS_TOKEN=your_access_token

# ===========================================
# INSTAGRAM
# ===========================================
INSTAGRAM_ACCOUNT_ID=your_account_id
INSTAGRAM_USER_ID=your_user_id

# ===========================================
# TELEGRAM
# ===========================================
TELEGRAM_ACCOUNT_ID=your_account_id
TELEGRAM_AUTH_CONFIG_ID=your_auth_config_id
TELEGRAM_ENTITY_ID=your_entity_id
TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_USERNAME=@your_bot
TELEGRAM_BOT_NAME=Your Bot Name
TELEGRAM_GROUP_USERNAME=@your_group
TELEGRAM_GROUP_NAME=Your Group Name
TELEGRAM_GROUP_CHAT_ID=-100xxxxxxxxx
TELEGRAM_BOT_TOKEN=your_bot_token

# ===========================================
# IMAGE GENERATION APIs (Cascade: Cloudflare → HuggingFace → Google → NVIDIA → Freepik → Pollinations)
# ===========================================
POLLINATIONS_API_KEY=your_pollinations_key
FREEPIK_API_KEY=your_freepik_key
IMGBB_API_KEY=your_imgbb_key

# ===========================================
# CoinMarketCap API (for Telegram crypto data)
# ===========================================
COINMARKETCAP_API_KEY=your_cmc_key
COINMARKETCAP_API_DEX_KEY=your_cmc_dex_key

# ===========================================
# SEARCH APIS (via Composio + direct scrapers)
# ===========================================
FIRECRAWL_API_KEY=your_firecrawl_key
HYPERBROWSER_API_KEY=your_hyperbrowser_key
SERPAPI_ACCOUNT_ID=your_serpapi_account
TAVILY_ACCOUNT_ID=your_tavily_account

# ===========================================
# GOOGLE SHEETS (for post tracking)
# ===========================================
GOOGLESHEETS_POSTS_SPREADSHEET_ID=1hQgjSao5SVkw5ISW9VZUfUnf9tMjELFAG_c4X6__T6w


# ===========================================
# TWITTER / X — direct OAuth posting is supported via TWITTER_* or X_* keys.
# If OAuth is unavailable, image posting will fall back to upload-post.com.
# Configure UPLOADPOST_API_KEY + UPLOAD_POST_PROFILE for upload-post fallback.
# ===========================================
UPLOAD_POST_API_KEY=your_upload_post_api_key
UPLOAD_POST_PROFILE=your_upload_post_profile

# ===========================================
# LINKEDIN — daily posting cap (post-pivot)
# ===========================================
LINKEDIN_DAILY_LIMIT=1

# ===========================================
# MEM0 (cloud) — long-term episodic memory layer
# Free tier: https://app.mem0.ai
# ===========================================
MEM0_API_KEY=your_mem0_key

# ===========================================
# CLOUDFLARE Workers AI — image generation primary
# Get keys at: https://dash.cloudflare.com → Workers AI
# ===========================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# ===========================================
# NVIDIA NIM (optional image gen / inference)
# ===========================================
NVIDIA_API_KEY=your_nvidia_api_key

# ===========================================
# BLOG / EMAIL
# ===========================================
BLOGGER_EMAIL=your.email@blogger.com
BLOG_AGENT_ENABLED=true
# Blog tuning (word/char limits, image embed, affiliate links)
BLOG_MIN_WORDS=500
BLOG_MAX_WORDS=800
BLOG_MAX_CHARS=12000
BLOG_INCLUDE_AFFILIATE_LINKS=false
BLOG_EMBED_IMAGE=true

# ===========================================
# GMAIL
# ===========================================
GMAIL_CONNECTED_ACCOUNT_ID=your_account_id
GMAIL_USER_ID=your_user_id
GMAIL_ACCESS_TOKEN=your_access_token
GMAIL_REFRESH_TOKEN=your_refresh_token
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token

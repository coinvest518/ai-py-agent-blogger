# FDWA AI Agent Environment Variables (example)
# Copy to .env and fill with real values. DO NOT COMMIT secrets.

# LLM API Keys
MISTRAL_API_KEY=
MISTRAL_IMAGE_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_AI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=
HUGGINGFACEHUB_API_TOKEN=
HF_TOKEN=

# LANGSMITH (Required for tracing)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=fdwa-multi-agent

# COMPOSIO
COMPOSIO_API_KEY=
COMPOSIO_API_URL=
COMPOSIO_ENTITY_ID=
COMPOSIO_GOOGLE_DOCS_ACCOUNT_ID=

# COMPOSIO toolkit version overrides (example)
COMPOSIO_TOOLKIT_VERSION_LINKEDIN=
COMPOSIO_TOOLKIT_VERSION_GOOGLEDOCS=

# Upload-Post
UPLOADPOST_API_KEY=
UPLOAD_POST_WEEKLY_CAP=2
UPLOAD_POST_PROFILE=Blogger

# Other service keys (placeholders)
ASTRA_DB_API_KEY=
MEM0_API_KEY=
GOOGLE_API_KEY=
DAYTONA_API_KEY=
DAYTONA_API_URL=

# Optional: secrets manager config
# SECRETS_PROVIDER=aws|gcp|vault

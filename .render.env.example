# FDWA Agent — Render environment template.
# Copy into the Render `fdwa-shared-env` env group.
# Both fdwa-web and fdwa-worker consume these; plus SUPERVISOR_ENABLED + RENDER_ROLE which render.yaml sets per service.
# Secrets only — do NOT commit real values.

# ---- LLM providers ----
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
GOOGLE_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---- Composio (all social platforms auto-resolve by entity) ----
COMPOSIO_API_KEY=
COMPOSIO_ENTITY_ID=
COMPOSIO_TOOLKIT_VERSION_LINKEDIN=
COMPOSIO_TOOLKIT_VERSION_FACEBOOK=
COMPOSIO_TOOLKIT_VERSION_TWITTER=
COMPOSIO_TOOLKIT_VERSION_INSTAGRAM=
COMPOSIO_TOOLKIT_VERSION_TELEGRAM=
COMPOSIO_TOOLKIT_VERSION_GMAIL=
COMPOSIO_TOOLKIT_VERSION_GOOGLESHEETS=20260211_00
COMPOSIO_DANGEROUSLY_SKIP_VERSION_CHECK=true

# ---- Social platform IDs ----
FACEBOOK_PAGE_ID=
LINKEDIN_AUTHOR_URN=
INSTAGRAM_USER_ID=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_GROUP_USERNAME=
TELEGRAM_FAILURE_GROUP_USERNAME=

# ---- Telegram two-way control ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_AI_OWNER_CHAT_ID=

# ---- Upload-post (Pinterest/X/Google Business, 10/mo cap) ----
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=
UPLOAD_POST_FORCE=false

# ---- Memory / tracing ----
MEM0_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fdwa-multi-agent
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_API_ENDPOINT=
ASTRA_COLLECTION_NAME=fdwa_memory

# ---- Google Analytics / Docs / Notion ----
GA_PROPERTY_ID=
GOOGLEDOCS_WEEKLY_DOC_ID=
NOTION_RUNS_PAGE_ID=

# ---- Crypto on-chain (Alchemy + CDP) ----
ALCHEMY_API_KEY=
AGENT_WALLET_ADDRESS=
CDP_NETWORK_ID=base-sepolia
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_ENABLE_SEND=false
CDP_MAX_TRANSFER_ETH=0.01
YIELDBOT_TOKEN_ADDRESS=

# ---- Briefing destinations ----
BRIEFING_EMAIL_TO=
BLOGGER_EMAIL=

# ---- Search / crypto data ----
COINMARKETCAP_API_KEY=
SERPAPI_KEY=
FIRECRAWL_API_KEY=
IMGBB_API_KEY=

# ---- Sheets (analytics) ----
GOOGLE_POSTS_SPREADSHEET_ID=
GOOGLE_TOKENS_SPREADSHEET_ID=

# ---- Limits ----
LINKEDIN_DAILY_LIMIT=1
SCHEDULER_INTERVAL_MINUTES=360
